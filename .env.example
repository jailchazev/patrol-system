# Copiar a .env en desarrollo local. Nunca subir secretos reales.
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@localhost:5432/patrol_system
# Configurar únicamente cuando se habiliten las integraciones:
CLOUDINARY_URL=
GOOGLE_SHEETS_WEBHOOK_URL=
